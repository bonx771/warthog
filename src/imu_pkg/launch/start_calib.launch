<launch>
  <arg name="serial_port" default="/dev/ttyUSB0" />
  <arg name="baud_rate" default="115200" />
  <arg name="serial_timeout_sec" default="0.05" />
  <arg name="read_chunk_size" default="256" />
  <arg name="countdown_sec" default="480.0" />
  <arg name="finish_wait_timeout_sec" default="60.0" />
  <arg name="response_required" default="false" />
  <arg name="auto_send" default="true" />
  <arg name="shutdown_on_finish" default="true" />
  <arg name="countdown_log_period_sec" default="10.0" />
  <arg name="log_all_frames" default="false" />
  <arg name="log_raw_rx" default="false" />
  <arg name="no_rx_warn_period_sec" default="10.0" />
  <arg name="reapply_output_after_start" default="true" />
  <arg name="reapply_output_on_finish" default="true" />
  <arg name="reapply_output_hz" default="25" />
  <arg name="reapply_output_data_mask" default="1" />
  <arg name="reapply_output_send_stop" default="true" />
  <arg name="reapply_output_delay_sec" default="0.2" />

  <node pkg="imu_pkg"
        type="start_calib.py"
        name="start_calib"
        output="screen">
    <param name="serial_port" value="$(arg serial_port)" />
    <param name="baud_rate" value="$(arg baud_rate)" />
    <param name="serial_timeout_sec" value="$(arg serial_timeout_sec)" />
    <param name="read_chunk_size" value="$(arg read_chunk_size)" />
    <param name="countdown_sec" value="$(arg countdown_sec)" />
    <param name="finish_wait_timeout_sec" value="$(arg finish_wait_timeout_sec)" />
    <param name="response_required" value="$(arg response_required)" />
    <param name="auto_send" value="$(arg auto_send)" />
    <param name="shutdown_on_finish" value="$(arg shutdown_on_finish)" />
    <param name="countdown_log_period_sec" value="$(arg countdown_log_period_sec)" />
    <param name="log_all_frames" value="$(arg log_all_frames)" />
    <param name="log_raw_rx" value="$(arg log_raw_rx)" />
    <param name="no_rx_warn_period_sec" value="$(arg no_rx_warn_period_sec)" />
    <param name="reapply_output_after_start" value="$(arg reapply_output_after_start)" />
    <param name="reapply_output_on_finish" value="$(arg reapply_output_on_finish)" />
    <param name="reapply_output_hz" value="$(arg reapply_output_hz)" />
    <param name="reapply_output_data_mask" value="$(arg reapply_output_data_mask)" />
    <param name="reapply_output_send_stop" value="$(arg reapply_output_send_stop)" />
    <param name="reapply_output_delay_sec" value="$(arg reapply_output_delay_sec)" />
  </node>
</launch>
