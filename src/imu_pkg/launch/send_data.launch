<launch>
  <arg name="serial_port" default="/dev/ttyUSB0" />
  <arg name="baud_rate" default="115200" />
  <arg name="serial_timeout_sec" default="0.05" />

  <arg name="output_hz" default="25" />
  <arg name="data_mask" default="1" />
  <arg name="send_gyrocompass_start" default="true" />
  <arg name="gyrocompass_start_delay_sec" default="0.2" />
  <arg name="send_stop_first" default="true" />
  <arg name="wait_after_send_sec" default="0.1" />

  <node pkg="imu_pkg"
        type="send_data.py"
        name="send_data"
        output="screen">
    <param name="serial_port" value="$(arg serial_port)" />
    <param name="baud_rate" value="$(arg baud_rate)" />
    <param name="serial_timeout_sec" value="$(arg serial_timeout_sec)" />
    <param name="output_hz" value="$(arg output_hz)" />
    <param name="data_mask" value="$(arg data_mask)" />
    <param name="send_gyrocompass_start" value="$(arg send_gyrocompass_start)" />
    <param name="gyrocompass_start_delay_sec" value="$(arg gyrocompass_start_delay_sec)" />
    <param name="send_stop_first" value="$(arg send_stop_first)" />
    <param name="wait_after_send_sec" value="$(arg wait_after_send_sec)" />
  </node>
</launch>
