<?xml version="1.0"?>
<launch>
  <!-- Terminal 2, simulation K2. It does not re-launch the EKFs/navsat. -->
  <arg name="selected_fix_topic" default="/outdoor_waypoint_nav/gps/fix_selected" />
  <arg name="waypoint_file" default="/waypoint_files/points_sim.txt" />
  <arg name="alpha" default="0.9" />
  <arg name="innovation_sigma_m" default="3.0" />
  <arg name="activation_mode" default="waypoint_interval" />
  <arg name="noise_start_after_waypoint_index" default="2" />
  <arg name="noise_stop_at_waypoint_index" default="4" />
  <!-- Simulation has ekf_se_odom's standard output, not filtered_odom. -->
  <arg name="distance_odom_topic" default="/outdoor_waypoint_nav/odometry/filtered" />
  <arg name="evaluation_enabled" default="true" />
  <arg name="evaluation_output_dir" default="/results/simulation" />
  <arg name="evaluation_show_plot" default="false" />
  <arg name="evaluation_finish_delay_sec" default="0.5" />
  <arg name="trajectory_logging_enabled" default="true" />
  <arg name="trajectory_output_dir" default="/results/simulation" />
  <arg name="trajectory_run_naming_mode" default="sequential" />

  <param name="/outdoor_waypoint_nav/coordinates_file"
         value="$(arg waypoint_file)"
         type="string" />

  <include file="$(find outdoor_waypoint_nav)/launch/include/gnss_correlated_noise.launch">
    <arg name="input_topic" value="/gps/fix" />
    <arg name="output_topic" value="/gps/fix_noisy" />
    <arg name="distance_odom_topic" value="$(arg distance_odom_topic)" />
    <arg name="activation_mode" value="$(arg activation_mode)" />
    <arg name="noise_start_after_waypoint_index" value="$(arg noise_start_after_waypoint_index)" />
    <arg name="noise_stop_at_waypoint_index" value="$(arg noise_stop_at_waypoint_index)" />
    <arg name="alpha" value="$(arg alpha)" />
    <arg name="innovation_sigma_m" value="$(arg innovation_sigma_m)" />
  </include>

  <!-- Keep the diagnostic noisy topic and send it as the sole EKF GNSS input. -->
  <node pkg="topic_tools"
        type="relay"
        name="scenario_2_sim_noisy_gps_to_navsat"
        args="/gps/fix_noisy $(arg selected_fix_topic)"
        output="screen" />

  <include file="$(find outdoor_waypoint_nav)/launch/include/experiment_control_and_evaluation.launch">
    <arg name="joy_control_launch"
         value="$(find outdoor_waypoint_nav)/launch/simulation/joy_launch_control_sim_no_gps_relay.launch" />
    <arg name="evaluation_enabled" value="$(arg evaluation_enabled)" />
    <arg name="evaluation_output_dir" value="$(arg evaluation_output_dir)" />
    <arg name="evaluation_show_plot" value="$(arg evaluation_show_plot)" />
    <arg name="evaluation_finish_delay_sec" value="$(arg evaluation_finish_delay_sec)" />
    <arg name="evaluation_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="evaluation_shutdown_after_report" value="false" />
    <arg name="trajectory_logging_enabled" value="$(arg trajectory_logging_enabled)" />
    <arg name="trajectory_output_dir" value="$(arg trajectory_output_dir)" />
    <arg name="trajectory_run_naming_mode" value="$(arg trajectory_run_naming_mode)" />
    <arg name="trajectory_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="trajectory_scenario_name" value="scenario_2_gnss_noise_sim" />
    <arg name="trajectory_scenario_metadata" value="environment=simulation;alpha=$(arg alpha);innovation_sigma_m=$(arg innovation_sigma_m);activation_mode=$(arg activation_mode);noise_start_after_wp=$(arg noise_start_after_waypoint_index);noise_stop_at_wp=$(arg noise_stop_at_waypoint_index)" />
  </include>
</launch>
