<?xml version="1.0"?>
<launch>
  <!--
    Terminal 2 for Scenario 4: route-shape influence on localization.

    Start Terminal 1 first:
      roslaunch outdoor_waypoint_nav outdoor_waypoint_nav.launch

    Then start this file. It supplies clean GNSS to Terminal 1, collects only
    WP1 plus robot direction interactively, calculates the other four points,
    and starts gps_waypoint only after r.
  -->
  <arg name="selected_fix_topic" default="/outdoor_waypoint_nav/gps/fix_selected" />
  <arg name="theta_deg" default="15.0" />
  <arg name="route_length_m" default="300.0" />
  <arg name="first_side" default="right" />
  <arg name="waypoint_file" default="/waypoint_files/points_scenario_4.txt" />
  <arg name="sample_duration_sec" default="5.0" />

  <arg name="evaluation_enabled" default="true" />
  <arg name="evaluation_output_dir" default="/results" />
  <arg name="evaluation_show_plot" default="false" />
  <arg name="evaluation_finish_delay_sec" default="0.5" />
  <arg name="trajectory_logging_enabled" default="true" />
  <arg name="trajectory_output_dir" default="/results/experiment_runs" />

  <!-- Terminal 1 navsat_transform uses the selected stream. Scenario 4 keeps
       it clean, while raw /gps/fix remains available as the reference logger
       source. -->
  <node pkg="topic_tools"
        type="relay"
        name="scenario_4_clean_gps_to_navsat"
        args="/gps/fix $(arg selected_fix_topic)"
        output="screen" />

  <!-- Publish the intended route file early. The file itself is atomically
       written by c before r starts gps_waypoint. -->
  <param name="/outdoor_waypoint_nav/coordinates_file"
         value="$(arg waypoint_file)"
         type="string" />

  <!-- K4 owns l/y/c/k/r itself. Do not include joy_launch_control.launch:
       its LB/RB callbacks start the legacy collector/sender. -->
  <node ns="/outdoor_waypoint_nav"
        pkg="outdoor_waypoint_nav"
        type="keyboard_to_joy.py"
        name="scenario_4_keyboard_control"
        output="screen">
    <param name="output_topic"
           value="/outdoor_waypoint_nav/scenario_4/keyboard_joy"
           type="string" />
    <param name="cmd_topic" value="" type="string" />
    <param name="button_count" value="8" type="int" />
    <param name="enable_motion_keys" value="false" type="bool" />
    <rosparam param="enabled_button_keys">["l", "y", "c", "k", "r", "b"]</rosparam>
  </node>

  <node ns="/outdoor_waypoint_nav"
        pkg="outdoor_waypoint_nav"
        type="scenario_4_waypoint_manager.py"
        name="scenario_4_waypoint_manager"
        output="screen">
    <param name="gps_topic" value="/gps/fix" type="string" />
    <param name="utm_frame" value="utm" type="string" />
    <param name="base_frame" value="base_link" type="string" />
    <param name="keyboard_joy_topic"
           value="/outdoor_waypoint_nav/scenario_4/keyboard_joy"
           type="string" />
    <param name="theta_deg" value="$(arg theta_deg)" type="double" />
    <param name="route_length_m" value="$(arg route_length_m)" type="double" />
    <param name="first_side" value="$(arg first_side)" type="string" />
    <param name="waypoint_file" value="$(arg waypoint_file)" type="string" />
    <param name="sample_duration_sec" value="$(arg sample_duration_sec)" type="double" />
    <rosparam param="allowed_theta_deg">[15.0, 30.0, 45.0]</rosparam>
  </node>

  <!-- The normal evaluator/logger are still launched in Terminal 2. For K4
       they wait for the manager's run_started event, because route generation
       happens interactively after this launch starts. -->
  <include file="$(find outdoor_waypoint_nav)/launch/include/experiment_control_and_evaluation.launch">
    <arg name="include_joy_control" value="false" />
    <arg name="evaluation_enabled" value="$(arg evaluation_enabled)" />
    <arg name="evaluation_output_dir" value="$(arg evaluation_output_dir)" />
    <arg name="evaluation_show_plot" value="$(arg evaluation_show_plot)" />
    <arg name="evaluation_finish_delay_sec" value="$(arg evaluation_finish_delay_sec)" />
    <arg name="evaluation_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="evaluation_defer_waypoint_load" value="true" />
    <arg name="evaluation_start_on_waypoint_index_zero" value="false" />
    <arg name="evaluation_start_topic"
         value="/outdoor_waypoint_nav/scenario_4/run_started" />
    <arg name="evaluation_allow_multiple_runs" value="false" />
    <arg name="trajectory_logging_enabled" value="$(arg trajectory_logging_enabled)" />
    <arg name="trajectory_output_dir" value="$(arg trajectory_output_dir)" />
    <arg name="trajectory_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="trajectory_start_topic"
         value="/outdoor_waypoint_nav/scenario_4/run_started" />
    <arg name="trajectory_allow_multiple_runs" value="false" />
    <arg name="trajectory_scenario_name"
         value="scenario_4_trajectory_theta_$(arg theta_deg)" />
    <arg name="trajectory_scenario_metadata"
         value="theta_deg=$(arg theta_deg);route_length_m=$(arg route_length_m);first_side=$(arg first_side);waypoint_file=$(arg waypoint_file)" />
  </include>
</launch>
