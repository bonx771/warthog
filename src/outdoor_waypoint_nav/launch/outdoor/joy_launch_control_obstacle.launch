<?xml version="1.0"?>
<launch>
  <!-- Same controls, locked to obstacle-only collect/send launch files. -->
  <arg name="collect_button_num" default="4" />
  <arg name="collect_button_sym" default="LB" />
  <arg name="send_button_num" default="5" />
  <arg name="send_button_sym" default="RB" />
  <arg name="calibrate_button_num" default="7" />
  <arg name="calibrate_button_sym" default="START" />
  <arg name="abort_button_num" default="1" />
  <arg name="abort_button_sym" default="B" />
  <arg name="continue_button_num" default="3" />
  <arg name="continue_button_sym" default="Y" />
  <arg name="home_button_num" default="0" />
  <arg name="home_button_sym" default="h" />
  <arg name="keyboard_joy_topic"
       default="/outdoor_waypoint_nav/keyboard_joy" />

  <node ns="/outdoor_waypoint_nav" pkg="outdoor_waypoint_nav"
        type="joy_launch_control_obstacle.py" name="joy_launch_control"
        output="screen" />

  <param name="/outdoor_waypoint_nav/collect_button_num"
         value="$(arg collect_button_num)" type="int" />
  <param name="/outdoor_waypoint_nav/collect_button_sym"
         value="$(arg collect_button_sym)" type="string" />
  <param name="/outdoor_waypoint_nav/send_button_num"
         value="$(arg send_button_num)" type="int" />
  <param name="/outdoor_waypoint_nav/send_button_sym"
         value="$(arg send_button_sym)" type="string" />
  <param name="/outdoor_waypoint_nav/calibrate_button_num"
         value="$(arg calibrate_button_num)" type="int" />
  <param name="/outdoor_waypoint_nav/calibrate_button_sym"
         value="$(arg calibrate_button_sym)" type="string" />
  <param name="/outdoor_waypoint_nav/abort_button_num"
         value="$(arg abort_button_num)" type="int" />
  <param name="/outdoor_waypoint_nav/abort_button_sym"
         value="$(arg abort_button_sym)" type="string" />
  <param name="/outdoor_waypoint_nav/continue_button_num"
         value="$(arg continue_button_num)" type="int" />
  <param name="/outdoor_waypoint_nav/continue_button_sym"
         value="$(arg continue_button_sym)" type="string" />
  <param name="/outdoor_waypoint_nav/home_button_num"
         value="$(arg home_button_num)" type="int" />
  <param name="/outdoor_waypoint_nav/home_button_sym"
         value="$(arg home_button_sym)" type="string" />
  <param name="/outdoor_waypoint_nav/sim_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/keyboard_waypoint_control_enabled"
         value="true" type="bool" />
  <param name="/outdoor_waypoint_nav/keyboard_joy_topic"
         value="$(arg keyboard_joy_topic)" type="string" />

  <node ns="/outdoor_waypoint_nav" pkg="outdoor_waypoint_nav"
        type="keyboard_to_joy.py" name="keyboard_waypoint_control"
        output="screen" launch-prefix="bash -lc">
    <param name="output_topic" value="$(arg keyboard_joy_topic)" type="string" />
    <param name="cmd_topic" value="" type="string" />
    <param name="button_count" value="8" type="int" />
    <param name="enable_motion_keys" value="false" type="bool" />
    <rosparam param="enabled_button_keys">["l", "y", "k", "r", "h", "b", "s"]</rosparam>
  </node>
</launch>
