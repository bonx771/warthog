<?xml version="1.0"?>

<launch>

  <!-- Keep the existing outdoor file as the default so legacy launches and
       joy_launch_control.py remain unchanged. Scenario-specific launchers can
       pass a different, package-relative waypoint file. -->
  <arg name="coordinates_file" default="/waypoint_files/points_outdoor.txt" />

  <node ns="/outdoor_waypoint_nav" pkg="outdoor_waypoint_nav" type="gps_waypoint" name="gps_waypoint" output="screen" />
  <param name="/outdoor_waypoint_nav/coordinates_file" value="$(arg coordinates_file)" type="string" />
  <param name="/outdoor_waypoint_nav/goal_frame" value="map" type="string" />
  <param name="/outdoor_waypoint_nav/waypoint_marker_frame" value="map" type="string" />
  <param name="/outdoor_waypoint_nav/waypoint_marker_topic" value="/outdoor_waypoint_nav/collected_waypoints" type="string" />
  <param name="/outdoor_waypoint_nav/waypoint_marker_scale" value="0.7" type="double" />
  <!-- Disable radius-based early advance. In direct-pursuit mode the C++
       controller enforces a hard minimum goal tolerance of 0.05 m; setting
       the direct tolerance itself to zero would incorrectly fall back to
       1.0 m, so 0.05 m is the closest possible setting without code changes. -->
  <param name="/outdoor_waypoint_nav/waypoint_marker_activation_radius" value="0.0" type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_advance_radius" value="0.0" type="double" />
  <param name="/outdoor_waypoint_nav/max_waypoint_goal_yaw_delta" value="0.35" type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_heading_preview_radius" value="0.7" type="double" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_max_attempts" value="2" type="int" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_reverse_distance" value="0.0" type="double" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_turn_angle_deg" value="90.0" type="double" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_forward_distance" value="1.5" type="double" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_linear_speed" value="0.50" type="double" />
  <param name="/outdoor_waypoint_nav/oscillation_recovery_angular_speed" value="0.55" type="double" />
  <param name="/outdoor_waypoint_nav/safety_replan_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/safety_replan_topic" value="/outdoor_waypoint_nav/replan_requested" type="string" />
  <param name="/outdoor_waypoint_nav/safety_replan_cooldown" value="0.0" type="double" />
  <param name="/outdoor_waypoint_nav/auto_replan_current_goal_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/auto_replan_current_goal_interval" value="0.0" type="double" />
  <param name="/outdoor_waypoint_nav/preferred_avoidance_turn_topic" value="/outdoor_waypoint_nav/preferred_avoidance_turn_direction" type="string" />
  <param name="/outdoor_waypoint_nav/preferred_avoidance_turn_deadband_deg" value="8.0" type="double" />
  <param name="/outdoor_waypoint_nav/preferred_avoidance_turn_sign" value="1.0" type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_cmd_topic" value="/cmd_vel" type="string" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_angle_threshold" value="0.35" type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_min_goal_distance" value="0.80" type="double" />
  <param name="/outdoor_waypoint_nav/return_to_start_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/return_heading_pid_enabled" value="false" type="bool" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_drive_enabled" value="true" type="bool" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_goal_tolerance" value="0.05" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_final_goal_tolerance" value="0.05" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_cruise_speed" value="0.54" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_min_speed" value="0.144" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_slow_radius" value="2.0" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_angular_kp" value="1.25" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_max_angular_speed" value="0.60" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_min_turn_speed" value="0.16" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_in_place_angle_threshold" value="1.55" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_progress_timeout" value="20.0" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_progress_epsilon" value="0.05" type="double" />
  <param name="/outdoor_waypoint_nav/direct_waypoint_control_frequency" value="20.0" type="double" />

</launch>
